SOLARNAV_ENV=development
SOLARNAV_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000
SOLARNAV_PANEL_MAX_POWER_W=1000
SOLARNAV_BATTERY_CAPACITY_WH=5000
SOLARNAV_BASE_LOAD_W=250
SOLARNAV_MOTOR_COST_WH_PER_DEG=0.02
SOLARNAV_OPTIMIZATION_HORIZON_MIN=30
SOLARNAV_SIMULATION_STEP_MIN=5
SOLARNAV_MIN_MOVE_GAIN_WH=2
NIM_BASE_URL=
NIM_API_KEY=
NIM_MODEL=
NIM_TIMEOUT_SECONDS=8
# NASA DONKI (space weather). Free key: https://api.nasa.gov — empty = DEMO_KEY (50 requests/day).
# Backend only: never put it in the frontend.
NASA_API_KEY=

# P1 data: real satellite position (free key on n2yo.com) and lunar base site
N2YO_API_KEY=
SOLARNAV_LUNAR_LAT_DEG=-89.5
SOLARNAV_LUNAR_LON_DEG=0.0
